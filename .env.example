# Polymarket API Configuration
# Copy this file to .env and fill in your credentials

# Polymarket API Credentials (optional - only needed for trading)
# Get these from: https://docs.polymarket.com/developers/CLOB/auth/api-keys
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=

# Alert Configuration
ALERT_PRICE_CHANGE_THRESHOLD=5  # Percentage change to trigger alert
ALERT_VOLUME_SPIKE_THRESHOLD=10000  # USDC volume spike threshold

# Notification Settings (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Monitoring Settings
UPDATE_INTERVAL=5  # Seconds between updates
ENABLE_TERMINAL_UI=true
LOG_LEVEL=INFO
